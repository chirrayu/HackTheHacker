# ==============================================================================
# HACK THE HACKER — Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL default, falls back to SQLite if unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackthehacker
SQLITE_FALLBACK_URL=sqlite:///./hackthehacker.db
USE_SQLITE_FALLBACK=true

# Security & App Environment
SECRET_KEY=dev-secret-key-replace-in-production-hackthehacker
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Capture & Upload Directories
PCAP_UPLOAD_DIR=./data/pcap_uploads
SURICATA_LOG_DIR=./data/suricata_logs
MAX_PCAP_SIZE_MB=100

# Virtual Lab Network Addresses
LAB_NETWORK=192.168.56.0/24
WINDOWS_HOST_IP=192.168.56.1
KALI_IP=192.168.56.20
METASPLOITABLE_IP=192.168.56.30

# Executable Tool Paths (Windows Native)
TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
DUMPCAP_PATH=C:\Program Files\Wireshark\dumpcap.exe
VBOXMANAGE_PATH=C:\Program Files\Oracle\VirtualBox\VBoxManage.exe
